# Copy to .env and fill in. Never commit .env.

# development | production
NODE_ENV=development

# Port the API listens on
PORT=5000

# Allowed browser origin(s) for CORS. Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=

# Reverse-proxy hops in front of the API (Express "trust proxy"). Leave empty for the
# default: 1 in production (typical PaaS), disabled in development.
TRUST_PROXY=

# Optional: use a different database than the one named in MONGODB_URI,
# e.g. MONGODB_DB_NAME=portfolio-prod to seed production with the same credentials.
MONGODB_DB_NAME=
