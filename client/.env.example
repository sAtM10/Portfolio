# Copy to .env and adjust. Only VITE_-prefixed variables reach the browser,
# so never put secrets here.

# Base URL of the Express API (no trailing slash). Leave empty for same-origin.
VITE_API_URL=http://localhost:5000

# Public URL of the deployed site (no trailing slash). Used for canonical/Open Graph tags,
# robots.txt and sitemap.xml. Required for production builds.
VITE_SITE_URL=http://localhost:5173

# Path or URL of the PUBLIC resume. Leave empty to hide all resume buttons; production
# builds then also omit resume.pdf. Only set it once a sanitized resume is committed.
VITE_RESUME_URL=
